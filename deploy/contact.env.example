# Se copiază în /etc/zecro/contact.env (chmod 600, proprietar root sau zecro). Nu se comite cu valori reale.
# Cheia din Resend; domeniul zec.ro trebuie verificat acolo (SPF + DKIM).
RESEND_API_KEY=
CONTACT_TO=office@zec.ro
CONTACT_FROM="ZECRO Site <noreply@zec.ro>"
# Serviciul ascultă doar local; nginx face proxy către el.
PORT=3001
HOST=127.0.0.1
# Originile de pe care se acceptă formulare (separate prin virgulă).
ALLOWED_ORIGINS=https://zec.ro,https://www.zec.ro
